# Copy to .env and adjust. Do not commit .env.

# Native runs: point at any PostgreSQL 16+ (compose sets this itself for containers).
# The README's docker run command starts one that matches this URL, and `migrate` creates the database if it is missing.
DATABASE_URL=postgresql://voice:change-me@127.0.0.1:5434/voice
DATA_ROOT=./var

# Docker Compose
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
VARIANT=cpu
INPUTS_DIR=/srv/voice-mcp/inputs
ASSETS_DIR=/srv/voice-mcp/assets

# Transport: stdio (trusted local, no OAuth) or streamable_http (OAuth required)
VOICE_MCP_SERVER__TRANSPORT=streamable_http
# The issuer exactly as it appears in tokens (the URL clients use to reach the provider).
VOICE_MCP_AUTH__ISSUER_URL=http://127.0.0.1:8080/realms/voice
VOICE_MCP_AUTH__AUDIENCE=http://127.0.0.1:8000/mcp
VOICE_MCP_AUTH__RESOURCE_SERVER_URL=http://127.0.0.1:8000/mcp
# Native runs reach the issuer directly, so keys are discovered from it; set VOICE_MCP_AUTH__JWKS_URL only if they can't be.
# VOICE_MCP_AUTH__JWKS_URL=
# How long startup waits for the provider (discovery and first key fetch) before failing.
# VOICE_MCP_AUTH__STARTUP_TIMEOUT_SECONDS=60

# Docker Compose only: where the app container fetches signing keys. The default targets the reference Keycloak
# on the Compose network; leave it empty for an external provider reachable at the issuer URL.
CONTAINER_JWKS_URL=http://keycloak:8080/realms/voice/protocol/openid-connect/certs

# Docker Compose only: Host and Origin headers the app accepts on its published port (127.0.0.1:8000). JSON lists;
# add a reverse proxy's public hostname (and browser origin, if any) when serving behind one.
MCP_ALLOWED_HOSTS=["127.0.0.1:8000","localhost:8000"]
MCP_ALLOWED_ORIGINS=[]
# Native runs bound beyond loopback must list them too (empty means loopback only):
# VOICE_MCP_SERVER__ALLOWED_HOSTS=["voice.example.com"]
# VOICE_MCP_SERVER__ALLOWED_ORIGINS=["https://voice.example.com"]

# Optional overrides
# WHISPER_BACKEND=auto        # auto | ctranslate2 | mlx
# TTS_BACKEND=auto            # auto | torch | mlx
# STORAGE_BACKEND=local       # local | s3
# VOICE_MCP_STORAGE__S3__BUCKET=my-private-bucket
# VOICE_MCP_STORAGE__S3__REGION=eu-west-1
# VOICE_MCP_OBSERVABILITY__LOG_FORMAT=console

# Separate GPU worker (docs/gpu-worker.md); defaults keep one all-in-one process.
# SERVICE_ROLE=all            # all | api | worker (the worker command sets worker itself)
# GPU_ON_DEMAND=false         # api role only: start the worker on demand and drain it when idle
# VOICE_MCP_GPU_WORKER__ON_DEMAND__TARGET=docker            # none | docker | aws_ecs
# VOICE_MCP_GPU_WORKER__ON_DEMAND__DRY_RUN=false
# VOICE_MCP_GPU_WORKER__ON_DEMAND__DOCKER__ENDPOINT=http://docker-proxy:2375
# VOICE_MCP_GPU_WORKER__ON_DEMAND__DOCKER__CONTAINER=voice-mcp-gpu-worker
# VOICE_MCP_GPU_WORKER__ON_DEMAND__AWS_ECS__REGION=eu-west-1
# VOICE_MCP_GPU_WORKER__ON_DEMAND__AWS_ECS__CLUSTER=voice
# VOICE_MCP_GPU_WORKER__ON_DEMAND__AWS_ECS__SERVICE=voice-gpu-worker
# VOICE_MCP_GPU_WORKER__IDLE_UNLOAD_SECONDS=0
# VOICE_MCP_STORAGE__INPUT_TRANSFER=shared_path             # shared_path | ingest
# Docker Compose split profile: the host's docker group ID for the socket proxy (getent group docker)
# DOCKER_GID=999
